# Copy to a private location (NOT into this public repo), e.g.:
#   cp agent/.env.example ~/.bigheavyink-agent.env
# then fill in the real values. The systemd unit reads that file.

# Must equal the Supabase secret NOTIFY_TOKEN — the shared password that
# proves a post really came from your functions.
NOTIFY_TOKEN=

# From resend.com (API Keys) after verifying bigheavyink.com there.
# Leave empty to run in dry-run mode: emails print to the log, nothing sends.
RESEND_API_KEY=

# The sender on outgoing mail. The domain must be verified in Resend.
MAIL_FROM=BIGHEAVYINK <hello@bigheavyink.com>

# PORT=8787
