{
  "spec_version": "1",
  "id": "demo-cleanse-contacts",
  "name": "Demo: normalise and dedupe contacts",
  "description": "Runs against the SQLite table seeded by examples/demo/seed.py.",
  "mode": "cleanse",
  "owner": "data-platform",
  "source": {
    "connector": "sqlite-table",
    "system": "crm.contacts",
    "config": {
      "path": "build/demo-crm.db",
      "table": "contacts",
      "key": "id"
    }
  },
  "scope": {
    "strategy": "full",
    "filter": {
      "status": "active"
    },
    "pushdown_required": true
  },
  "limits": {
    "batch_size": 100,
    "concurrency": 4,
    "max_records_matched": 10000,
    "max_mutations": 500,
    "max_dlq_rate_pct": 5
  },
  "safety": {
    "dry_run_required": true,
    "dry_run_max_age_hours": 24,
    "approvals_required": 1,
    "divergence_tolerance_pct": 20,
    "rollback_window_hours": 168
  },
  "action": {
    "type": "cleanse",
    "on_invalid": "flag",
    "rules": [
      {
        "id": "trim-whitespace",
        "type": "normalise",
        "version": "1.0.0",
        "fields": [
          "first_name",
          "last_name",
          "email",
          "address_line1"
        ]
      },
      {
        "id": "email-lowercase",
        "type": "normalise",
        "version": "1.0.0",
        "fields": [
          "email"
        ]
      },
      {
        "id": "phone-e164",
        "type": "normalise",
        "version": "2.1.0",
        "fields": [
          "phone"
        ],
        "config": {
          "default_region": "US"
        }
      },
      {
        "id": "postal-usps",
        "type": "normalise",
        "version": "1.4.0",
        "fields": [
          "address_line1",
          "postal_code"
        ]
      },
      {
        "id": "email-deliverable",
        "type": "validate",
        "version": "1.2.0",
        "fields": [
          "email"
        ]
      },
      {
        "id": "contact-merge",
        "type": "merge",
        "version": "3.0.0"
      }
    ],
    "matching": {
      "blocking_keys": [
        "postal_code",
        "email_domain",
        "last_name_soundex"
      ],
      "comparators": [
        {
          "field": "email",
          "method": "exact",
          "weight": 0.45
        },
        {
          "field": "phone",
          "method": "exact",
          "weight": 0.25
        },
        {
          "field": "last_name",
          "method": "jaro_winkler",
          "weight": 0.15
        },
        {
          "field": "address_line1",
          "method": "token_set_ratio",
          "weight": 0.15
        }
      ],
      "auto_merge_above": 0.95,
      "review_below": 0.25
    },
    "survivorship": [
      {
        "field": "email",
        "policy": "most_recent"
      },
      {
        "field": "phone",
        "policy": "most_complete"
      },
      {
        "field": "address_line1",
        "policy": "highest_trust_source"
      }
    ]
  }
}
