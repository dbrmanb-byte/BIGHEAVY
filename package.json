{
  "name": "bigheavy",
  "private": true,
  "version": "0.1.0",
  "description": "BIGHEAVYINK study apps — offline-first PWAs built from one monorepo against shared packages.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "build": "pnpm run build:packages && pnpm --filter \"./apps/*\" build",
    "preflight": "bash scripts/preflight.sh",
    "serve": "node scripts/serve.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
